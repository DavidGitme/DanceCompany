SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria
# Neon (PostgreSQL). Copiar la cadena de "Connect" en Neon y cambiar postgresql:// por postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTOS=20
REFRESH_TOKEN_DIAS=7
COOKIE_SEGURA=false
MODO_MOCK=true
CLAVE_MOCK_ADMIN=cambiar_por_una_clave_local_de_8_o_mas_caracteres
# Correo con Gmail: activar la verificación en 2 pasos y crear una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones). Sin estos datos no se envían correos.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=academia@gmail.com
SMTP_CLAVE=contraseña_de_aplicacion_de_16_letras
SMTP_REMITENTE=academia@gmail.com
# Dirección pública del frontend (para los enlaces de los correos)
FRONTEND_URL=https://dancecompany-psi.vercel.app
